# SPDX-License-Identifier: GPL-2.0-or-later

chip soc/amd/picasso
	# Set FADT Configuration
	register "common_config.fadt_boot_arch" = "ACPI_FADT_LEGACY_DEVICES | ACPI_FADT_8042"
	register "common_config.fadt_flags" = "ACPI_FADT_SLEEP_BUTTON"
	register "acp_i2s_use_external_48mhz_osc" = "1"
	# register "emmc_config" = "{
	# 	.timing = SD_EMMC_DISABLE,
	# }"

	register "i2c_scl_reset" = "GPIO_I2C2_SCL | GPIO_I2C3_SCL"
	register "i2c[3].early_init" = "1"
	# I2C Pad Control RX Select Configuration
	# register "i2c_pad[3].rx_level" = "I2C_PAD_RX_1_8V" TODO: doesn't exist in picasso

	# general purpose PCIe clock output configuration
	register "gpp_clk_config[0]" = "GPP_CLK_ON"
	register "gpp_clk_config[1]" = "GPP_CLK_ON"
	register "gpp_clk_config[2]" = "GPP_CLK_ON"
	register "gpp_clk_config[3]" = "GPP_CLK_ON"
	register "gpp_clk_config[4]" = "GPP_CLK_ON"
	register "gpp_clk_config[5]" = "GPP_CLK_ON"
	register "gpp_clk_config[6]" = "GPP_CLK_ON"

	register "pspp_policy" = "DXIO_PSPP_BALANCED"

	device domain 0 on
		subsystemid 0x1022 0x1510 inherit
		device ref iommu on end
		device ref gpp_bridge_0 on end # PCIE2
		device ref gpp_bridge_1 on # X370
			# device pci 0.0 alias x370_xhci on ops xhci_pci_ops end
			# device pci 0.1 alias x370_sata on ops amd_sata_ops end
			# device pci 0.2 alias hub_bridge_0 on ops amd_external_pcie_gpp_ops end
			# device pci 0.3 alias hub_bridge_1 on ops amd_external_pcie_gpp_ops end
			# device pci 0.4 alias hub_bridge_2 on ops amd_external_pcie_gpp_ops end
			# device pci 0.5 alias hub_bridge_3 on ops amd_external_pcie_gpp_ops end
			# device pci 0.6 alias hub_bridge_4 on ops amd_external_pcie_gpp_ops end
			# device pci 0.7 alias hub_bridge_5 on ops amd_external_pcie_gpp_ops end
			# device pci 0.8 alias hub_bridge_6 on ops amd_external_pcie_gpp_ops end
			# device pci 0.9 alias hub_bridge_7 on ops amd_external_pcie_gpp_ops end
		end
		device ref gpp_bridge_5 on end # NVME
		# sio gp34 is connected to M2_1:PRSNT#
		# LDN 0x09, reg 0xe5 reads 0x72 without and 0x62 with
		device ref internal_bridge_a on
			device ref gfx on end		# Internal GPU
			device ref gfx_hda on end	# Display HDA
			device ref crypto on end	# Crypto Coprocessor
			device ref xhci_0 on end	# USB 3.1
			device ref xhci_1 on end	# USB 3.1
			device ref hda on end		# HDA
		end	# internal_bridge_a
		device ref internal_bridge_b on
			device ref sata on end
		end	# internal_bridge_b
		device ref lpc_bridge on
			chip superio/nuvoton/nct6779d
				device pnp 2e.1 off end		# Parallel
				device pnp 2e.2 on		# UART A
					io  0x60 = 0x3f8
					irq 0x70 = 4
				end
				device pnp 2e.3 off end		# UART B, IR
				device pnp 2e.5 on		# Keyboard
					io  0x60 = 0x60
					io  0x62 = 0x64
					irq 0x70 = 1
					irq 0x72 = 12
				end
				device pnp 2e.6   off end	# CIR
				device pnp 2e.7   off end	# GPIO6-8
				device pnp 2e.8   off end	# WDT1, GPIO0, GPIO1
				device pnp 2e.108 on  end	# GPIO0
				device pnp 2e.9   off end	# GPIO1-8
				device pnp 2e.109 on  end	# GPIO1
				device pnp 2e.209 on  end	# GPIO2
				device pnp 2e.309 on  end	# GPIO3
				device pnp 2e.409 on  end	# GPIO4
				device pnp 2e.509 on  end	# GPIO5
				device pnp 2e.609 off end	# GPIO6
				device pnp 2e.709 on  end	# GPIO7
				device pnp 2e.a   on  end	# ACPI
				device pnp 2e.b   on		# H/W Monitor, FP LED
					io  0x60 = 0x290
					io  0x62 = 0x2a0
					irq 0x70 = 0
				end
				device pnp 2e.d   off end	# WDT1
				device pnp 2e.e   off end	# CIR Wake-up
				device pnp 2e.f   off end	# Push-pull/Open-Drain
				device pnp 2e.14  off end	# Port 80 UART
				device pnp 2e.16  off end	# Deep Sleep
			end
		end	# lpc_bridge
	end	# domain
	device ref i2c_2 on end
	device ref i2c_3 on end
end	# chip soc/amd/picasso
